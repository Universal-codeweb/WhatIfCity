# Environment Configuration Template
# Copy this file to .env and fill in the values

# App Configuration
APP_NAME=WhatIfCity
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# LLM / AI API Keys (Optional depending on model provider)
